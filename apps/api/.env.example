RUST_LOG=info

# Mapbox
MAPBOX_PRIVATE_KEY=

# Ticketmaster
TICKETMASTER_API_KEY=

# PredictHQ (optional — omit to disable the PredictHQ event source; see
# crate::predicthq module docs)
PREDICTHQ_API_KEY=

# Spotify OAuth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Apple Music (optional — omit APPLE_MUSIC_TEAM_ID to disable Apple Music routes)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us

# Database
DATABASE_URL=

# Session cookies
COOKIE_DOMAIN=
COOKIE_KEY=
COOKIE_SECURE=false

# Comma-separated list of origins allowed to call this API cross-origin.
# Defaults to http://localhost:5173 if unset. Set this to your frontend's
# reverse-proxy origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
